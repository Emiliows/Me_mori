Estructura de Datos
Esquema PostgreSQL (Supabase)
sql
Copy
-- Perfil de personalidad evolutivo
CREATE TABLE personality_profiles (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    subject_name TEXT NOT NULL,
    created_at TIMESTAMP DEFAULT NOW(),
    updated_at TIMESTAMP DEFAULT NOW(),
    voice_settings JSONB, -- Config ElevenLabs
    psychological_profile JSONB, -- Big Five, valores, etc
    linguistic_patterns JSONB, -- Análisis de estilo
    is_active BOOLEAN DEFAULT true
);

-- Memorias extraídas
CREATE TABLE memories (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    profile_id UUID REFERENCES personality_profiles(id),
    content TEXT NOT NULL,
    memory_type TEXT CHECK (memory_type IN ('fact', 'story', 'opinion', 'relationship', 'value')),
    emotional_tone TEXT,
    source_conversation_id UUID,
    created_at TIMESTAMP DEFAULT NOW(),
    embedding VECTOR(1536) -- Para búsqueda semántica
);

-- Conversaciones crudas (audio + transcripción)
CREATE TABLE conversations (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    profile_id UUID REFERENCES personality_profiles(id),
    audio_url TEXT, -- S3 signed URL
    transcription TEXT,
    speaker_type TEXT CHECK (speaker_type IN ('subject', 'family_member')),
    extracted_insights JSONB, -- Qué aprendió Claude de esta conversación
    created_at TIMESTAMP DEFAULT NOW()
);

-- Sesiones de chat (para contexto)
CREATE TABLE chat_sessions (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    profile_id UUID REFERENCES personality_profiles(id),
    family_member_id TEXT, -- Anónimo o identificado
    context_window JSONB, -- Últimos N mensajes
    created_at TIMESTAMP DEFAULT NOW()
);
