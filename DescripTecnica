Pipeline de Procesamiento
1. Ingesta de Voz (Subject)
Python
Copy
async def process_voice_input(audio_blob: bytes, profile_id: str):
    # 1. Guardar audio crudo en S3
    audio_url = await s3.upload(audio_blob)
    
    # 2. Transcripción Whisper
    transcription = await whisper.transcribe(audio_blob)
    
    # 3. Análisis con Claude
    analysis = await claude.analyze_personality_input(
        transcription=transcription,
        existing_profile=profile.get(profile_id),
        prompt=PERSONALITY_EXTRACTION_PROMPT
    )
    
    # 4. Extraer y guardar memorias
    for memory in analysis.extracted_memories:
        await save_memory(profile_id, memory)
        await pinecone.upsert(memory.embedding, memory.metadata)
    
    # 5. Actualizar perfil psicológico
    await update_psychological_profile(profile_id, analysis.profile_delta)
    
    # 6. Guardar conversación
    await db.conversations.insert({
        "profile_id": profile_id,
        "audio_url": audio_url,
        "transcription": transcription,
        "extracted_insights": analysis
    })
    
    return {"status": "processed", "insights": analysis.summary}
2. Generación de Respuesta (Family)
Python
Copy
async def generate_response(audio_input: bytes, profile_id: str, session_id: str):
    # 1. STT
    user_message = await whisper.transcribe(audio_input)
    
    # 2. Recuperar contexto
    session = await db.chat_sessions.get(session_id)
    relevant_memories = await pinecone.search(
        query=user_message,
        filter={"profile_id": profile_id},
        top_k=5
    )
    
    # 3. Construir prompt dinámico
    system_prompt = build_dynamic_prompt(
        profile=await db.profiles.get(profile_id),
        memories=relevant_memories,
        recent_history=session.context_window
    )
    
    # 4. Generar respuesta Claude
    response_text = await claude.generate(
        system=system_prompt,
        messages=session.context_window + [{"role": "user", "content": user_message}]
    )
    
    # 5. Síntesis de voz (ElevenLabs)
    audio_response = await elevenlabs.generate(
        text=response_text,
        voice_settings=profile.voice_settings,
        model="eleven_turbo_v2_5"
    )
    
    # 6. Actualizar sesión
    await update_session_context(session_id, user_message, response_text)
    
    return {
        "audio": audio_response,
        "text": response_text, # Fallback
        "sources": [m.id for m in relevant_memories] # Transparencia
    }
