# scripts/export-personality.py
async def full_export(profile_id: str):
    profile = await db.profiles.get(profile_id)
    memories = await db.memories.get_all(profile_id)
    conversations = await db.conversations.get_all(profile_id)
    
    export_package = {
        "format_version": "1.0",
        "export_date": datetime.now().isoformat(),
        "profile": profile,
        "memories": memories,
        "conversations_sample": conversations[:100], # Últimas 100
        "generated_prompt": build_static_prompt(profile, memories),
        "checksums": {...} # Integridad datos
    }
    
    # Guardar en GitHub Releases + S3 + local
    await github.create_release(export_package)
    await s3.upload(f"backups/{profile_id}/{date}.json", export_package)
    
    return export_package
